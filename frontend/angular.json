                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb"
                }
              ],
              "localize": false
            }
          },
          "defaultConfiguration": ""
        },
        "serve": {
          "builder": "@angular-devkit/build-angular:dev-server",
          "options": {
            "buildTarget": "lightning:build",
            "proxyConfig": "proxy.conf.lightning.cjs",
            "host": "127.0.0.1",
            "port": 4580
          },
          "configurations": {
            "production": {
              "buildTarget": "lightning:build:production"
            }
          }
        }
      }
    }
  }
}
